{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unreviewed bank claim/evidence draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claims",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject_id",
          "statement",
          "category",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "category": {
            "enum": [
              "source_statement",
              "historical_claim",
              "interpretation",
              "personal_reflection",
              "fiction"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim_id",
          "source_id",
          "relation",
          "locator",
          "rationale",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "claim_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "relation": {
            "enum": [
              "supports",
              "contradicts",
              "contextualizes",
              "mentions"
            ]
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "start",
                  "end",
                  "exact"
                ],
                "properties": {
                  "type": {
                    "const": "text_span"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048576
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  },
                  "exact": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "pdf_page",
                  "printed_page",
                  "note"
                ],
                "properties": {
                  "type": {
                    "const": "page"
                  },
                  "pdf_page": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "printed_page": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "label",
                  "note"
                ],
                "properties": {
                  "type": {
                    "const": "section"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "start_ms",
                  "end_ms",
                  "note"
                ],
                "properties": {
                  "type": {
                    "const": "time_range"
                  },
                  "start_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
