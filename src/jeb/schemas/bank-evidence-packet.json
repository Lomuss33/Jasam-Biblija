{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revision-bound unreviewed bank evidence packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_format",
    "packet_id",
    "workspace_id",
    "base_head",
    "created_at",
    "prepared_by",
    "review_state",
    "approval_authority",
    "schema_hashes",
    "draft",
    "bindings",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bank_format": {
      "const": "2.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "manifest_sha256"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "prepared_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "tool"
          ]
        }
      }
    },
    "review_state": {
      "const": "unreviewed"
    },
    "approval_authority": {
      "const": "none"
    },
    "schema_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bank-evidence-draft",
        "bank-evidence-packet"
      ],
      "properties": {
        "bank-evidence-draft": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bank-evidence-packet": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "claims",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "subject_id",
              "statement",
              "category",
              "limitations"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "subject_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "category": {
                "enum": [
                  "source_statement",
                  "historical_claim",
                  "interpretation",
                  "personal_reflection",
                  "fiction"
                ]
              },
              "limitations": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claim_id",
              "source_id",
              "relation",
              "locator",
              "rationale",
              "limitations"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "claim_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "relation": {
                "enum": [
                  "supports",
                  "contradicts",
                  "contextualizes",
                  "mentions"
                ]
              },
              "locator": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "start",
                      "end",
                      "exact"
                    ],
                    "properties": {
                      "type": {
                        "const": "text_span"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1048576
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      },
                      "exact": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "pdf_page",
                      "printed_page",
                      "note"
                    ],
                    "properties": {
                      "type": {
                        "const": "page"
                      },
                      "pdf_page": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "printed_page": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "label",
                      "note"
                    ],
                    "properties": {
                      "type": {
                        "const": "section"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "start_ms",
                      "end_ms",
                      "note"
                    ],
                    "properties": {
                      "type": {
                        "const": "time_range"
                      },
                      "start_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end_ms": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    }
                  }
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "limitations": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "revision_id",
          "record_sha256",
          "body_sha256"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "body_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
