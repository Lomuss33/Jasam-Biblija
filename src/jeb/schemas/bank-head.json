{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge-bank committed head",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "manifest_sha256"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
