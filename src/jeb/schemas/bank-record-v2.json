{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal knowledge-bank revision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "id",
    "kind",
    "title",
    "created_at",
    "recorded_by",
    "revision_id",
    "parent_revision",
    "body_sha256",
    "visibility",
    "processing_state",
    "data",
    "revised_at",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "entity",
        "source",
        "article"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "tool"
          ]
        }
      }
    },
    "revision_id": {
      "$ref": "#/$defs/id"
    },
    "parent_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "body_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "visibility": {
      "enum": [
        "private",
        "shared",
        "public_candidate"
      ]
    },
    "processing_state": {
      "enum": [
        "inbox",
        "organized",
        "researched"
      ]
    },
    "data": {
      "type": "object"
    },
    "revised_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "entity"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "article"
          }
        }
      },
      "then": {
        "properties": {
          "body_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "data": {
            "$ref": "#/$defs/article"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "optional_text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2000
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "person",
            "place",
            "event",
            "organization",
            "concept",
            "work"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "creator",
        "translator",
        "edition",
        "url",
        "accessed_at",
        "limitations"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "book",
            "document",
            "webpage",
            "interview",
            "other"
          ]
        },
        "creator": {
          "$ref": "#/$defs/optional_text"
        },
        "translator": {
          "$ref": "#/$defs/optional_text"
        },
        "edition": {
          "$ref": "#/$defs/optional_text"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects",
        "sources"
      ],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
