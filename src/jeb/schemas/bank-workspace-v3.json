{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed personal knowledge-bank workspace v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "title",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
