{
  "$defs": {
    "node": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "children": {
              "items": {
                "$ref": "#/$defs/node"
              },
              "maxItems": 100000,
              "minItems": 1,
              "type": "array"
            },
            "style": {
              "enum": [
                "italic",
                "bold"
              ]
            },
            "type": {
              "const": "emphasis"
            }
          },
          "required": [
            "type",
            "style",
            "children"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:jeb:schema:collection:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "books": {
      "items": {
        "enum": [
          "GEN",
          "MAT",
          "MRK",
          "LUK",
          "JHN"
        ]
      },
      "maxItems": 100000,
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "decision_date": {
      "format": "date",
      "type": "string"
    },
    "decision_text": {
      "minLength": 1,
      "type": "string"
    },
    "profile_id": {
      "const": "five-book"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "books",
    "decision_date",
    "decision_text"
  ],
  "type": "object"
}
