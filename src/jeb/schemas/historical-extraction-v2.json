{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic historical extraction with retained PDF projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "synthetic", "releasable", "artifact_id", "status", "reason", "candidates", "provenance", "projection_file"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "record_type": {"const": "historical_extraction"},
    "synthetic": {"const": true},
    "releasable": {"const": false},
    "artifact_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"const": "complete"},
    "reason": {"type": "null"},
    "candidates": {"type": "array", "maxItems": 10000, "items": {"type": "object"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "projection_file": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "byte_length"],
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "source_sha256", "projection_sha256", "projection", "offset_unit", "adapter"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "projection_sha256": {"$ref": "#/$defs/hash"},
        "projection": {"const": "pdftotext_utf8"},
        "offset_unit": {"const": "unicode_code_points"},
        "adapter": {"type": "string", "pattern": "^pdftotext:[0-9a-f]{64}$"}
      }
    }
  }
}
