{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private historical pipeline checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "workspace_id", "synthetic", "releasable", "label", "input_root", "registry_sha256", "revision", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "historical_pipeline"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "synthetic": {"type": "boolean"},
    "releasable": {"const": false},
    "label": {"type": "string", "minLength": 1, "maxLength": 500},
    "input_root": {"type": "string", "minLength": 1, "maxLength": 4000},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "revision": {"type": "integer", "minimum": 0},
    "tasks": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "status", "reason", "attempts", "cache_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"enum": ["queued", "processing", "complete", "pending", "needs_review"]},
        "reason": {"type": ["string", "null"], "maxLength": 200},
        "attempts": {"type": "integer", "minimum": 0},
        "cache_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
