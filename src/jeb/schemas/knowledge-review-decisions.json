{
  "$id": "urn:jeb:schema:knowledge-review-decisions:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "human_attestation": {
      "const": true
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "enum": [
                "content_and_scope_checked",
                "attribution_checked",
                "category_and_uncertainty_checked",
                "support_inspected",
                "contribution_rights_checked",
                "revision_relationship_checked"
              ]
            },
            "maxItems": 6,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "draft_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "rationale": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "record_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "state": {
            "enum": [
              "approved",
              "rejected",
              "needs_review"
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "version_of": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "approval_sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "provenance_sha256": {
                    "anyOf": [
                      {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "record_id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
                    "type": "string"
                  },
                  "record_sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "record_id",
                  "record_sha256",
                  "approval_sha256",
                  "provenance_sha256"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "record_id",
          "draft_sha256",
          "state",
          "rationale",
          "checks",
          "supersedes"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "response_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "reviewer_role": {
      "const": "owner"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "packet_id",
    "packet_sha256",
    "response_sha256",
    "policy_sha256",
    "reviewer_id",
    "reviewer_role",
    "human_attestation",
    "reviewed_at",
    "items"
  ],
  "type": "object"
}
