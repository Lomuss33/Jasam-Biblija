{
  "$id": "urn:jeb:schema:passage-research-response:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_authority": {
      "const": "none"
    },
    "human_attestation": {
      "const": false
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "known_evidence_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "lead_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "outcome": {
            "enum": [
              "leads_found",
              "no_new_evidence"
            ]
          },
          "questions": {
            "items": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "segment_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "type": "string"
          },
          "summary": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "text_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "uncertainty": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "text_sha256",
          "outcome",
          "summary",
          "known_evidence_ids",
          "lead_ids",
          "questions",
          "uncertainty"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "leads": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "access_date": {
            "format": "date",
            "type": "string"
          },
          "bibliographic_details": {
            "maxLength": 1500,
            "minLength": 1,
            "type": "string"
          },
          "lead_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "locator": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "relationship": {
            "enum": [
              "primary_record",
              "secondary_record",
              "derived_copy",
              "unknown"
            ]
          },
          "source_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "maxLength": 1500,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [
          "lead_id",
          "source_id",
          "url",
          "bibliographic_details",
          "locator",
          "access_date",
          "summary",
          "relationship"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 0,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "review_state": {
      "const": "unreviewed"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "task": {
      "const": "research"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "model_identifier": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "reported_at": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_identifier",
        "reported_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "packet_sha256",
    "source_id",
    "tool",
    "limitations",
    "review_state",
    "approval_authority",
    "human_attestation",
    "task",
    "items",
    "leads"
  ],
  "type": "object"
}
