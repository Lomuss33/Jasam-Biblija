{
  "$id": "urn:jeb:schema:review-assistance-response:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_authority": {
      "const": "none"
    },
    "human_attestation": {
      "const": false
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "flag_assessments": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "assessment": {
                  "enum": [
                    "concern_remains",
                    "question_for_owner",
                    "requires_expert"
                  ]
                },
                "flag": {
                  "pattern": "^[a-z][a-z0-9_]{0,79}$",
                  "type": "string"
                },
                "rationale": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "flag",
                "assessment",
                "rationale"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          },
          "issues": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "enum": [
                    "negation",
                    "number",
                    "name",
                    "protected_form",
                    "meaning",
                    "linguistic",
                    "source_mapping",
                    "evidence",
                    "uncertainty",
                    "other"
                  ]
                },
                "evidence_ids": {
                  "items": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
                    "type": "string"
                  },
                  "maxItems": 50,
                  "minItems": 0,
                  "type": "array",
                  "uniqueItems": true
                },
                "issue_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
                  "type": "string"
                },
                "suggested_check": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                },
                "summary": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "issue_id",
                "category",
                "summary",
                "suggested_check",
                "evidence_ids"
              ],
              "type": "object"
            },
            "maxItems": 10,
            "minItems": 0,
            "type": "array"
          },
          "observation": {
            "enum": [
              "no_issues_observed",
              "concerns",
              "needs_expert_review"
            ]
          },
          "proposed_text_sha256": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "segment_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
            "type": "string"
          },
          "source_text_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "uncertainty": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "source_text_sha256",
          "proposed_text_sha256",
          "observation",
          "rationale",
          "flag_assessments",
          "issues",
          "uncertainty"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "review_state": {
      "const": "unreviewed"
    },
    "reviewer_kind": {
      "const": "ai_assistance"
    },
    "schema_version": {
      "const": "1.0"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "model_identifier": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "reported_at": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_identifier",
        "reported_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "packet_sha256",
    "proposal_id",
    "proposal_sha256",
    "tool",
    "reviewer_kind",
    "items",
    "limitations",
    "review_state",
    "approval_authority",
    "human_attestation"
  ],
  "type": "object"
}
