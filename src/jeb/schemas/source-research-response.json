{
  "$id": "urn:jeb:schema:source-research-response:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpus_permission": {
      "const": false
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "known_evidence_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "lead_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "limitations": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "outcome": {
            "enum": [
              "leads_found",
              "no_new_evidence"
            ]
          },
          "question_id": {
            "enum": [
              "exact_edition",
              "digital_provenance",
              "component_rights",
              "versification_fidelity",
              "adapter"
            ]
          },
          "summary": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "outcome",
          "summary",
          "known_evidence_ids",
          "lead_ids",
          "limitations"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array"
    },
    "leads": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "access_date": {
            "format": "date",
            "type": "string"
          },
          "lead_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "locator": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "relationship": {
            "enum": [
              "direct_record",
              "derived_record",
              "unknown"
            ]
          },
          "summary": {
            "maxLength": 1500,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [
          "lead_id",
          "url",
          "locator",
          "access_date",
          "summary",
          "relationship"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 0,
      "type": "array"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "review_state": {
      "const": "unreviewed"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$",
      "type": "string"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "model_identifier": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "reported_at": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_identifier",
        "reported_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "source_id",
    "packet_sha256",
    "tool",
    "items",
    "leads",
    "review_state",
    "corpus_permission"
  ],
  "type": "object"
}
