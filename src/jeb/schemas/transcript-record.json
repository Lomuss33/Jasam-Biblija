{
  "$defs": {
    "node": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "children": {
              "items": {
                "$ref": "#/$defs/node"
              },
              "maxItems": 100000,
              "minItems": 1,
              "type": "array"
            },
            "style": {
              "enum": [
                "italic",
                "bold"
              ]
            },
            "type": {
              "const": "emphasis"
            }
          },
          "required": [
            "type",
            "style",
            "children"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:jeb:schema:transcript-record:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "book_id": {
          "enum": [
            "GEN",
            "MAT",
            "MRK",
            "LUK",
            "JHN"
          ]
        },
        "scheme": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "book"
        }
      },
      "required": [
        "type",
        "book_id",
        "scheme"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "paragraph",
            "poetry"
          ]
        },
        "level": {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "block"
        }
      },
      "required": [
        "type",
        "block_id",
        "kind",
        "level"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "alternate_labels": {
          "items": {
            "pattern": "^[0-9]+[a-z]?(?:-[0-9]+[a-z]?)?$",
            "type": "string"
          },
          "maxItems": 100000,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "chapter_label": {
          "pattern": "^[0-9]+[a-z]?(?:-[0-9]+[a-z]?)?$",
          "type": "string"
        },
        "parts": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "block_id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
                    "type": "string"
                  },
                  "text": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": {
                    "const": "text"
                  }
                },
                "required": [
                  "type",
                  "text",
                  "block_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "annotation_id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
                    "type": "string"
                  },
                  "content": {
                    "items": {
                      "$ref": "#/$defs/node"
                    },
                    "maxItems": 100000,
                    "minItems": 1,
                    "type": "array"
                  },
                  "kind": {
                    "enum": [
                      "heading",
                      "footnote",
                      "cross_reference",
                      "introduction"
                    ]
                  },
                  "type": {
                    "const": "note"
                  }
                },
                "required": [
                  "type",
                  "annotation_id",
                  "kind",
                  "content"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 100000,
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "segment"
        },
        "verse_label": {
          "pattern": "^[0-9]+[a-z]?(?:-[0-9]+[a-z]?)?$",
          "type": "string"
        },
        "verse_labels": {
          "items": {
            "pattern": "^[0-9]+[a-z]?(?:-[0-9]+[a-z]?)?$",
            "type": "string"
          },
          "maxItems": 100000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "chapter_label",
        "verse_label",
        "verse_labels",
        "alternate_labels",
        "parts"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "end"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ]
}
